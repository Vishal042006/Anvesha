# ================================================================================
# ANVESHA 3.0 — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ================================================================================
# Instructions:
# 1. Copy this file to .env: `cp .env.example .env`
# 2. Update with your local configuration.
# 3. DO NOT COMMIT .env WITH PRODUCTION SECRETS TO VERSION CONTROL.
# ================================================================================

# --- Local Ollama AI Subsystem ---
# Default local Ollama host (IPv4 loopback recommended for macOS/Linux)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Recommended lightweight model (494MB) or upgrade to qwen2.5:7b if GPU RAM permits
OLLAMA_MODEL=qwen2.5:0.5b

# --- Scholarly Research Evidence APIs (Optional but recommended) ---
# Crossref polite pool contact email
CROSSREF_EMAIL=researcher@example.com
# OpenAlex API Key (Free registration at openalex.org)
OPENALEX_API_KEY=your_openalex_api_key_here
# Semantic Scholar API Key (Free registration at semanticscholar.org)
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here
# Hugging Face Access Token for BGE-M3 embeddings
HF_TOKEN=your_huggingface_token_here

# --- Real-Time Incident News Feeds (Optional) ---
# GNews API Key (gnews.io)
GNEWS=your_gnews_api_key_here
# NewsData.io API Key (newsdata.io)
NEWSDATA=your_newsdata_api_key_here

# --- System & Application Settings ---
PROJECT_NAME="ANVESHA Research AI Platform"
VERSION="3.0.0"
ENVIRONMENT="development"
